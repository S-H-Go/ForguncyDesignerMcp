<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ForguncyRoot Condition="'$(ForguncyRoot)' == ''">C:\ProgramData\Forguncy 12</ForguncyRoot>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.24</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\Icon.png" />
    <EmbeddedResource Include="Resources\Tray.ico" LogicalName="ForguncyDesignerMcp.Designer.Tray.ico" />
    <ProjectReference Include="..\ForguncyDesignerMcp.Core\ForguncyDesignerMcp.Core.csproj" />
    <ProjectReference Include="..\ForguncyDesignerMcp.Host\ForguncyDesignerMcp.Host.csproj" />
    <ProjectReference Include="..\ForguncyDesignerMcp.Adapters.V11\ForguncyDesignerMcp.Adapters.V11.csproj" />
    <ProjectReference Include="..\ForguncyDesignerMcp.Adapters.V12\ForguncyDesignerMcp.Adapters.V12.csproj" />
  </ItemGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Forguncy.Log.Abstractions" Exclude="runtime">
      <HintPath>$(ForguncyRoot)\WebSite\bin\Forguncy.Log.Abstractions.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Forguncy.Commands" Exclude="runtime">
      <HintPath>$(ForguncyRoot)\WebSite\bin\Forguncy.Commands.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Forguncy.Commands.Design" Exclude="runtime">
      <HintPath>$(ForguncyRoot)\WebSite\designerBin\Forguncy.Commands.Design.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.CellTypes" Exclude="runtime">
      <HintPath>$(ForguncyRoot)\WebSite\bin\GrapeCity.Forguncy.CellTypes.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.CellTypes.Design" Exclude="runtime">
      <HintPath>$(ForguncyRoot)\WebSite\designerBin\GrapeCity.Forguncy.CellTypes.Design.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.Plugin" Exclude="runtime">
      <HintPath>$(ForguncyRoot)\WebSite\bin\GrapeCity.Forguncy.Plugin.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.Plugin.Design" Exclude="runtime">
      <HintPath>$(ForguncyRoot)\WebSite\designerBin\GrapeCity.Forguncy.Plugin.Design.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GrapeCity.Forguncy.ServerApi">
      <HintPath>$(ForguncyRoot)\WebSite\bin\GrapeCity.Forguncy.ServerApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Analyzer Include="..\PackageTools\PluginAnalyzer.dll" Condition="Exists('..\PackageTools\PluginAnalyzer.dll')" />
  </ItemGroup>
  <!-- Packaging is explicit in scripts/Build-Package.ps1. The vendor's Debug
       post-build target auto-installs plugins and must never run during builds. -->
</Project>
